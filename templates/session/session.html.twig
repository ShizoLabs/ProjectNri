{% extends 'base.html.twig' %}

{% block title %}Session{% endblock %}

{% block javascripts %}
{{ parent() }}
{# Set tokens #}
<script>
    window.SESSION_TOKENS = {{ tokens|json_encode|raw }};
    window.SESSION_MAP = {{ map|json_encode|raw }};
    window.SESSION_ID = {{ sessionId|json_encode|raw }};
    window.SESSION_OPEN_URL = {{ path('session_open', {id: sessionId})|json_encode|raw }};
    window.SESSION_FORMULAS = {{ sessionFormulas|json_encode|raw }};
</script>
{# Phaser #}
<script src="https://cdn.jsdelivr.net/npm/phaser@3.80.1/dist/phaser.min.js"></script>
{{ importmap('session') }}
{% endblock %}

{% block body %}
<div class="session-layout">
    <!-- Left control panel -->
    <div id="map-tools" class="map-tools">
        <div class="map-tools-header">Map tools</div>
        <button class="tool-btn" type="button" data-tool="zoom-in">Zoom in</button>
        <button class="tool-btn" type="button" data-tool="zoom-out">Zoom out</button>
        <button class="tool-btn" type="button" data-tool="zoom-reset">Zoom reset</button>
        <button class="tool-btn" type="button" data-tool="center-map">Center map</button>
        <button class="tool-btn" type="button" data-tool="toggle-grid">Toggle grid</button>
        <button class="tool-btn tool-danger" type="button" data-tool="remove-token">Remove selected token</button>
    </div>

    <!-- Game container -->
    <div class="map-area">
        <div class="map-top-right">
            <button id="map-list-toggle" class="map-top-btn" type="button">Maps</button>
            <div id="map-list-panel" class="map-list-panel">
                <div class="map-list-title">Session maps</div>
                <div class="map-list-items">
                    {% for mapItem in sessionMaps %}
                        <button
                            class="map-switch-btn{% if map is not null and mapItem.id == map.id %} active{% endif %}"
                            type="button"
                            data-map-id="{{ mapItem.id }}"
                        >
                            <span>{{ mapItem.name }}</span>
                            <small>{{ mapItem.width }}x{{ mapItem.height }}</small>
                        </button>
                    {% else %}
                        <div class="map-empty">No maps found</div>
                    {% endfor %}
                </div>
                <div class="modal map-create-btn" data-href="{{ path('map_create', {session: sessionId}) }}">
                    <span>Create new map</span>
                </div>
            </div>
        </div>
        <div id="game-container"></div>
        <div id="function-result-panel" class="function-result-panel">
            <div class="function-result-title">Function Results</div>
            <div id="function-result-list" class="function-result-list"></div>
        </div>
    </div>

    <!-- Right control panel -->
    <div id="control-panel" class="control-panel">
        <!-- Tabs buttons -->
        <div id="tabs" style="display: flex; margin-bottom: 1rem;">
            <button class="tab-btn active" data-tab="tab1" style="flex:1;">Sheets</button>
            <button class="tab-btn" data-tab="tab2" style="flex:1;">Rules</button>
            <button class="tab-btn" data-tab="tab3" style="flex:1;">Settings</button>
        </div>
        <!-- Tab content -->
        <div id="tab-content">
            <div class="tab" id="tab1">
                <div class="modal" data-href="{{ path('token_create', {session: sessionId}) }}">
                    <span>Create character/object</span>
                </div>
                <div>
                    {% for token in sessionTokens %}
                        <div class="token-row" data-token-id="{{ token.id }}" data-token-name="{{ token.name }}" draggable="true">
                            {% if token.imagePath %}
                                <img class="token-thumb" src="{{ asset(token.imagePath) }}" alt="{{ token.name }}">
                            {% endif %}
                            <div class="token-row-main">
                                <span>{{ token.name }}</span>
                                {% if token.sheetTemplateName %}
                                    <small class="token-sheet-meta">
                                        {{ token.sheetTemplateName }}
                                    </small>
                                {% endif %}
                            </div>
                            <button class="token-place-btn" type="button">Add to map</button>
                            <button class="modal token-edit-btn" type="button" data-href="{{ path('token_edit', {id: token.id, session: sessionId}) }}">Edit</button>
                            <button class="token-function-btn" type="button">Function</button>
                            <button class="token-delete-btn" type="button">Delete</button>
                        </div>
                    {% else %}
                        <span>No tokens</span>
                    {% endfor %}
                </div>
            </div>
            <div class="tab" id="tab2" style="display:none;">Content for Tab 2</div>
            <div class="tab" id="tab3" style="display:none;">
                <p><strong>Session:</strong> {{ sessionName }}</p>
                <p>
                    <strong>Workshop system:</strong>
                    {{ sessionWorkshopSystemName ?? 'Not selected' }}
                </p>
                <div class="modal" data-href="{{ path('session_edit', {id: sessionId}) }}">
                    <span>Edit session</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="token-function-popup" class="token-function-popup" hidden>
    <div class="token-function-card">
        <div class="token-function-header">
            <div class="token-function-title">Run Function</div>
            <button id="token-function-close" type="button">Close</button>
        </div>
        <div id="token-function-target" class="token-function-target"></div>
        <input id="token-function-token-id" type="hidden">
        <div class="token-function-row">
            <label for="token-function-select">From workshop formulas</label>
            <select id="token-function-select">
                <option value="">Custom expression</option>
            </select>
        </div>
        <div class="token-function-row">
            <label for="token-function-name">Name</label>
            <input id="token-function-name" type="text" placeholder="e.g. Strength Save">
        </div>
        <div class="token-function-row">
            <label for="token-function-expression">Expression</label>
            <textarea id="token-function-expression" rows="3" placeholder="e.g. 1d20 + strength_mod + proficiency"></textarea>
        </div>
        <div id="token-function-error" class="token-function-error" hidden></div>
        <button id="token-function-run" type="button">Run</button>
    </div>
</div>

<div id="token-context-menu" class="token-context-menu" hidden>
    <button id="token-context-run-function" type="button">Run function</button>
</div>
{% endblock %}
