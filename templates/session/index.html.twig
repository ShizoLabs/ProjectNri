{% extends 'base.html.twig' %}

{% block title %}Sessions menu{% endblock %}

{% block body %}
<div class="modal-overlay">
    <h1>Sessions</h1>

    <div class="modal" data-href="{{ path('session_create') }}">
        <span>Create new session</span>
    </div>

    {% if sessions is empty %}
        <p>No sessions yet.</p>
    {% else %}
        <ul class="session-list">
            {% for session in sessions %}
                <li>
                    <a href="{{ path('session_open', {id: session.id}) }}">
                        {{ session.name }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
{% endblock %}
