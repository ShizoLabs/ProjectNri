{% extends 'base.html.twig' %}

{% block title %}Hello SessionController!{% endblock %}

{% block javascripts %}
{{ parent() }}
{# Phaser #}
<script src="https://cdn.jsdelivr.net/npm/phaser@3.80.1/dist/phaser.min.js"></script>
{% block importmap %}{{ importmap('session') }}{% endblock %}
{% endblock %}

{% block body %}
<div style="display: flex; height: 70rem;">
    <!-- Left control panel -->

    <!-- Game container -->
    <div id="game-container" style="flex-grow: 1; background: #222; overflow: hidden;"></div>
    <!-- Right control panel -->
    <div id="control-panel" style="width: 20rem; background: #333; color: #fff; padding: 1rem;">
        <!-- Tabs buttons -->
        <div id="tabs" style="display: flex; margin-bottom: 1rem;">
            <button class="tab-btn active" data-tab="tab1" style="flex:1;">Tokens</button>
            <button class="tab-btn" data-tab="tab2" style="flex:1;">Rules</button>
            <button class="tab-btn" data-tab="tab3" style="flex:1;">Settings</button>
        </div>
        <!-- Tab content -->
        <div id="tab-content">
            <div class="tab" id="tab1">Content for Tab 1</div>
            <div class="tab" id="tab2" style="display:none;">Content for Tab 2</div>
            <div class="tab" id="tab3" style="display:none;">Content for Tab 3</div>
        </div>
    </div>
</div>
{% endblock %}
