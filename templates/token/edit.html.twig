{% extends 'modalContent.html.twig' %}

{% block modalContent %}
        <h1>Edit Token</h1>

        {{ form_start(form, {
            action: path('token_edit', {id: tokenId, session: sessionId}),
            method: 'POST',
            attr: {
                'data-token-builder': 'true',
                'data-token-template-catalog': tokenTemplateCatalog|json_encode|e('html_attr'),
                'data-token-values': tokenValues|json_encode|e('html_attr')
            }
        }) }}
            {{ form_errors(form) }}
            <textarea data-token-template-catalog-source hidden>{{ tokenTemplateCatalog|json_encode }}</textarea>
            <textarea data-token-values-source hidden>{{ tokenValues|json_encode }}</textarea>
            {{ form_row(form.name) }}
            {{ form_row(form.sizeX) }}
            {{ form_row(form.sizeY) }}
            {{ form_row(form.rotation) }}
            {{ form_row(form.workshopSystemId) }}
            <div class="token-template-block">
                <div class="token-template-title">Sheet Values</div>
                {{ form_row(form.sheetTemplateId) }}
                <div class="token-template-summary" data-token-template-summary></div>
                <div class="token-template-fields" data-token-template-fields></div>
            </div>
            {{ form_widget(form.valuesJson) }}
            {{ form_row(form.imageFile) }}

            <button type="submit">Update</button>
        {{ form_end(form) }}
{% endblock %}
