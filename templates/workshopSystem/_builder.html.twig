{% set isEditable = editable is defined and editable %}
{% set isTemplatesOnly = templatesOnly is defined and templatesOnly %}

<div class="workshop-system-layout" data-workshop-builder data-editable="{{ isEditable ? 'true' : 'false' }}">
    <aside class="workshop-panel workshop-tools">
        <div class="workshop-panel-title">Constructor</div>
        {% if not isTemplatesOnly %}
            <button class="tool-btn" type="button" data-action="add-tab" {% if not isEditable %}disabled{% endif %}>Add tab</button>
            <button class="tool-btn" type="button" data-action="add-resource" {% if not isEditable %}disabled{% endif %}>Add resource</button>
            <button class="tool-btn" type="button" data-action="add-ability" {% if not isEditable %}disabled{% endif %}>Add ability</button>
            <button class="tool-btn" type="button" data-action="add-formula" {% if not isEditable %}disabled{% endif %}>Add formula</button>
        {% endif %}
        {# data-action читает assets/workshopSystem.js: кнопки ничего не делают сами по себе,
           они только объявляют, какое изменение нужно внести в state конструктора. #}
        <button class="tool-btn" type="button" data-action="add-sheet-template" {% if not isEditable %}disabled{% endif %}>Add sheet template</button>
        {# Поле листа может ссылаться на существующий resource системы. #}
        <button class="tool-btn" type="button" data-action="add-sheet-resource-field" {% if not isEditable %}disabled{% endif %}>Add resource field</button>
        {# Formula field привязывается к вычисляемой формуле и создаётся как read-only. #}
        <button class="tool-btn" type="button" data-action="add-sheet-formula-field" {% if not isEditable %}disabled{% endif %}>Add formula field</button>
        {# Local field создаёт независимое поле шаблона листа:
           оно не связано ни с resource, ни с formula, хранит собственный sourceKey/key
           и подходит для значений уровня конкретного токена, например HP или Armor Class. #}
        <button class="tool-btn" type="button" data-action="add-sheet-local-field" {% if not isEditable %}disabled{% endif %}>Add local field</button>
        {% if not isTemplatesOnly %}
            <div class="workshop-panel-hint">
                Drag resources, abilities, and formulas between two columns to set their position.
            </div>
        {% endif %}
    </aside>

    <main class="workshop-panel workshop-constructor">
        {% if not isTemplatesOnly %}
            <div class="workshop-tabs-bar" data-tabs-bar></div>
            <div class="workshop-tab-panel" data-tab-panel></div>
        {% endif %}
        <div class="workshop-sheet-templates" data-sheet-templates-section>
            <div class="workshop-panel-title">Sheet templates</div>
            <div class="workshop-sheet-template-list" data-sheet-template-list></div>
            <div class="workshop-sheet-template-editor" data-sheet-template-editor></div>
        </div>
    </main>
</div>

{% if form is defined %}
    <div class="workshop-hidden-fields" data-workshop-fields>
        {% if form.settings is defined %}
            {{ form_widget(form.settings, {'attr': {'data-workshop-field': 'settings'}}) }}
        {% endif %}
        {% if form.resources is defined %}
            {{ form_widget(form.resources, {'attr': {'data-workshop-field': 'resources'}}) }}
        {% endif %}
        {% if form.abilities is defined %}
            {{ form_widget(form.abilities, {'attr': {'data-workshop-field': 'abilities'}}) }}
        {% endif %}
        {% if form.tabs is defined %}
            {{ form_widget(form.tabs, {'attr': {'data-workshop-field': 'tabs'}}) }}
        {% endif %}
        {% if form.formulas is defined %}
            {{ form_widget(form.formulas, {'attr': {'data-workshop-field': 'formulas'}}) }}
        {% endif %}
        {% if form.sheetTemplates is defined %}
            {{ form_widget(form.sheetTemplates, {'attr': {'data-workshop-field': 'sheetTemplates'}}) }}
        {% endif %}
        {% if form.meta is defined %}
            {{ form_widget(form.meta, {'attr': {'data-workshop-field': 'meta'}}) }}
        {% endif %}
    </div>
{% endif %}
