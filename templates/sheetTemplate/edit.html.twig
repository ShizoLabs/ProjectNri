{% extends 'base.html.twig' %}

{% block title %}Edit Sheet Templates{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    window.WORKSHOP_SYSTEM = {{ {
        id: system.id,
        name: system.name,
        slug: system.slug,
        version: system.version,
        resources: system.resources,
        abilities: system.abilities,
        tabs: system.tabs,
        formulas: system.formulas,
        sheetTemplates: system.sheetTemplates
    }|json_encode|raw }};
</script>
{{ importmap('workshopSystem') }}
{% endblock %}

{% block body %}
<div class="workshop-system-content">
    <div class="workshop-system-header">
        <div>
            <h1>Sheet Types for {{ system.name }}</h1>
            <div class="workshop-system-subtitle">Edit only token sheet templates.</div>
        </div>
        <div class="workshop-system-actions">
            <a class="workshop-system-back" href="{{ path('sheet_template_index') }}">Back to Sheet Types</a>
            <a class="workshop-system-back" href="{{ path('workshop_system_open', {id: system.id}) }}">Open Workshop System</a>
        </div>
    </div>

    {{ form_start(form, {action: path('sheet_template_edit', {id: system.id}), method: 'POST'}) }}
        {{ form_errors(form) }}

        {% include 'workshopSystem/_builder.html.twig' with { editable: true, form: form, templatesOnly: true } %}

        <button class="workshop-save-btn" type="submit">Save sheet templates</button>
    {{ form_end(form) }}
</div>
{% endblock %}
